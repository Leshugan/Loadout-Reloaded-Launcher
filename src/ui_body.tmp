static ImFont* fSemi = nullptr;
static ImFont* fBold = nullptr;

static const ImU32 C_BG = IM_COL32(17, 18, 21, 255);
static const ImU32 C_PANEL = IM_COL32(24, 26, 30, 255);
static const ImU32 C_CARD = IM_COL32(32, 35, 41, 255);
